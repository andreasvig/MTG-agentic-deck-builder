# FastAPI server
MTG_HOST=127.0.0.1
MTG_PORT=43127
MTG_FRONTEND_ORIGIN=http://127.0.0.1:41737

# Local card catalog (created by `npm run catalog:sync`)
MTG_CARD_CATALOG_PATH=local-data/cards.sqlite3
MTG_SCRYFALL_BULK_TIMEOUT_SECONDS=900
MTG_SCRYFALL_REQUEST_INTERVAL_SECONDS=0.1

# Optional Tagger details/filter/embedding-concept sidecar
# (created by `npm run tagger:sync`)
MTG_TAGGER__DATABASE_PATH=local-data/card-tagger.sqlite3

# Optional on-demand EDHREC commander cache
MTG_EDHREC__DATABASE_PATH=local-data/card-edhrec.sqlite3

# Required only while search.agentic.enabled is true in config.yaml
OPENROUTER_API_KEY=

# Search diagnostics
MTG_SEARCH_DEBUG_ENABLED=false
MTG_SEARCH_DEBUG_LOG_PATH=local-data/search-debug.jsonl
MTG_SEARCH_DEBUG_RESULT_LIMIT=25

# Browser API client
VITE_API_BASE_URL=http://127.0.0.1:43127/api/v1
